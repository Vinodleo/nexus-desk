rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.uid == request.auth.uid;
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && 
                    incoming().diff(existing()).affectedKeys().hasAny(['equity', 'cash', 'dailyRealizedPnl', 'selfApprovedCount', 'selfApprovedWins', 'selfApprovedLosses', 'lastUpdated', 'accuracyPct', 'promotedLabModel', 'dailyTelemetry', 'lastLoginAt']);
      
      match /experiences/{experienceId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(experienceId) &&
                      incoming().keys().hasAll(['userId']) && incoming().userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      
      
      // Exchange keys are server-held only. Clients may read/delete the
      // legacy plain-text copy written by earlier builds, but never write one.
      match /credentials/{credentialId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if false;
      }
      match /closedTrades/{tradeId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(tradeId) &&
                      incoming().keys().hasAll(['userId']) && incoming().userId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /activePositions/{positionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(positionId) &&
                              incoming().keys().hasAll(['userId']) && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
    
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(logId) && 
                    incoming().keys().hasAll(['userId']) && incoming().userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}
