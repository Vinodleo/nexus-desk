# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ZERODHA_API_KEY: Required for Kite Connect API (Zerodha)
ZERODHA_API_KEY="YOUR_ZERODHA_API_KEY"
ZERODHA_API_SECRET="YOUR_ZERODHA_API_SECRET"

# ANGEL_*: Angel One SmartAPI, for Indian stocks (Nifty 50 candles, live
# prices and market depth; no orders). The server logs in by itself each day:
# ANGEL_CLIENT_CODE is your Angel One client ID, ANGEL_PIN your 4-digit login
# PIN, ANGEL_TOTP_SECRET the text key shown when you enabled TOTP at
# smartapi.angelone.in. Leave them out and stocks simply aren't scanned.
# ANGEL_API_KEY="YOUR_SMARTAPI_KEY"
# ANGEL_CLIENT_CODE="A123456"
# ANGEL_PIN="1234"
# ANGEL_TOTP_SECRET="YOUR_TOTP_KEY"

# ALPACA_*: Alpaca PAPER keys, for US stocks (paper only; free IEX data:
# candles, last trade, best bid and ask). From alpaca.markets → Paper Trading
# → API Keys. Prices are shown in rupees at the day's USD/INR reference rate;
# USD_INR_RATE pins the rate instead. Leave them out and US stocks aren't scanned.
# ALPACA_API_KEY_ID="PK..."
# ALPACA_API_SECRET_KEY="..."
# USD_INR_RATE="84.00"

# COINDCX_API_KEY / SECRET: CoinDCX execution API. Held only on the server —
# the browser never sees them. Create the key with withdrawals disabled.
COINDCX_API_KEY="YOUR_COINDCX_API_KEY"
COINDCX_API_SECRET="YOUR_COINDCX_API_SECRET"

# ALLOWED_EMAILS: comma-separated, verified Firebase account emails allowed to
# call /api and the WebSocket. If empty, every request is rejected.
ALLOWED_EMAILS="you@example.com"

# FIREBASE_PROJECT_ID: optional override; defaults to firebase-applet-config.json.
# FIREBASE_PROJECT_ID=""

# Live-order limits, enforced server-side. Live orders are rejected unless
# LIVE_TRADING_ENABLED is exactly "true". Exits of positions the server opened
# are always allowed.
LIVE_TRADING_ENABLED="false"
LIVE_ALLOWED_MARKETS="BTCINR,ETHINR,SOLINR,AVAXINR,NEARINR,JUPINR,XRPINR"
LIVE_MAX_ORDER_NOTIONAL_INR="5000"
LIVE_MAX_DAILY_NOTIONAL_INR="20000"
LIVE_MAX_DAILY_ORDERS="10"
LIVE_MAX_PRICE_DEVIATION_PCT="1.0"

# NEXUS_DATA_DIR: where guardian state and the live-order ledger/registry are
# saved (default ./data). Point it at a persistent volume in production.
# NEXUS_DATA_DIR="/var/lib/nexus-desk"

# GEMINI_MODELS: comma-separated Gemini models to try in order (optional).
# Default: gemini-3.8-flash,gemini-3.1-flash-lite. The server logs a warning if
# a name is rejected, since the agents would otherwise quietly fall back.
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.1-flash-lite"

# With GEMINI_API_KEY set, Gemini also reviews each trade the server's
# autopilot is about to open, and can skip it (server/tradeReviewer.ts). It
# never opens one; without an answer the trade goes ahead. Optional:
# GEMINI_REVIEW_MODELS: models to try in order (default
#   gemini-3.8-flash,gemini-3.1-flash-lite: when one hits Google's limit, the next carries on).
# GEMINI_REVIEW_DAILY_LIMIT: reviews per day, India time (default 300).
# GEMINI_REVIEW_MODELS="gemini-3.8-flash,gemini-3.1-flash-lite"
# GEMINI_REVIEW_DAILY_LIMIT="300"

# PORT: HTTP port (default 3000).
# PORT="3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
