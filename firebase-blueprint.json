{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Trader profiles and RBAC role assignments",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["commander", "trader", "auditor"] },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "equity": { "type": "number" },
        "cash": { "type": "number" },
        "dailyRealizedPnl": { "type": "number" },
        "selfApprovedCount": { "type": "number" },
        "selfApprovedWins": { "type": "number" },
        "selfApprovedLosses": { "type": "number" },
        "lastUpdated": { "type": "string" },
        "accuracyPct": { "type": "number" }
      },
      "required": ["uid"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Security and trade execution audit ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "ExperienceVector": {
      "title": "Experience Vector",
      "description": "Historical experience vector for the neural net",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "timestamp": { "type": "string" },
        "ticker": { "type": "string", "maxLength": 50 },
        "pattern": { "type": "string", "maxLength": 100 },
        "regime": { "type": "string", "maxLength": 100 },
        "outcome": { "type": "string", "maxLength": 50 },
        "features": { "type": "object" }
      }
    },
    "HistoricalTrade": {
      "title": "Historical Trade",
      "description": "Record of a closed trade",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "symbol": { "type": "string", "maxLength": 50 },
        "direction": { "type": "string", "maxLength": 50 },
        "entryPrice": { "type": "number" },
        "exitPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "moneyPlaced": { "type": "number" },
        "realizedPnl": { "type": "number" },
        "isWin": { "type": "boolean" },
        "exitReason": { "type": "string", "maxLength": 50 },
        "openedAt": { "type": "string" },
        "closedAt": { "type": "string" },
        "autopsy": { "type": "object" }
      }
    },
    "ActivePosition": {
      "title": "Active Position",
      "description": "Currently open trade position tracked by daemon",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\\\-]+$" },
        "symbol": { "type": "string", "maxLength": 50 },
        "direction": { "type": "string", "maxLength": 50 },
        "entryPrice": { "type": "number" },
        "currentPrice": { "type": "number" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" },
        "quantity": { "type": "number" },
        "moneyPlaced": { "type": "number" },
        "trailActive": { "type": "boolean" },
        "trailMode": { "type": "string", "maxLength": 50 },
        "highestPrice": { "type": "number" },
        "lowestPrice": { "type": "number" },
        "openTime": { "type": "string" },
        "setupName": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "userId", "symbol", "direction", "entryPrice"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and global state"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Global audit logs"
    },
    "/users/{userId}/experiences/{experienceId}": {
      "schema": { "$ref": "#/entities/ExperienceVector" },
      "description": "Experience vectors per user"
    },
    "/users/{userId}/closedTrades/{tradeId}": {
      "schema": { "$ref": "#/entities/HistoricalTrade" },
      "description": "Closed trades per user"
    },
    "/users/{userId}/activePositions/{positionId}": {
      "schema": { "$ref": "#/entities/ActivePosition" },
      "description": "Active positions monitored across devices"
    }
  }
}
